// ============================================================================
// billing.prisma — Pricing, subscription, pembayaran  (owner: B4)
// ============================================================================

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

enum SubscriptionSource {
  PURCHASE
  MANUAL_GRANT
  TRIAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum SubscriptionEventType {
  CREATED
  ACTIVATED
  EXTENDED
  REVOKED
  EXPIRED
  RENEWED
}

model SubscriptionPlan {
  id                String     @id @default(uuid()) @db.Uuid
  code              String     @unique
  name              String
  tagline           String?
  priceIdr          Int        @map("price_idr")
  compareAtPriceIdr Int?       @map("compare_at_price_idr")
  durationDays      Int        @map("duration_days")
  features          Json
  badge             String?
  isPopular         Boolean    @default(false) @map("is_popular")
  isPublic          Boolean    @default(true) @map("is_public")
  sortOrder         Int        @default(0) @map("sort_order")
  status            PlanStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  /**
   * Soft delete (F5-02). Paket yang sudah dipakai transaksi/langganan tidak
   * boleh dihapus fisik karena riwayat pembayaran harus tetap terbaca; baris
   * hanya disembunyikan dari pembeli dan panel.
   */
  deletedAt         DateTime?  @map("deleted_at")

  subscriptions Subscription[]
  transactions  Transaction[]

  @@index([status, isPublic, sortOrder])
  @@index([deletedAt])
  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planId             String?            @map("plan_id") @db.Uuid
  sourceTransactionId String?           @map("source_transaction_id") @db.Uuid
  source             SubscriptionSource @default(PURCHASE)
  status             SubscriptionStatus @default(PENDING)
  startsAt           DateTime           @map("starts_at")
  endsAt             DateTime           @map("ends_at")
  grantedById        String?            @map("granted_by") @db.Uuid
  grantNote          String?            @map("grant_note")
  revokedAt          DateTime?          @map("revoked_at")
  revokeReason       String?            @map("revoke_reason")
  lastReminderAt     DateTime?          @map("last_reminder_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user             User              @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  grantedBy        User?             @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  events           SubscriptionEvent[]
  transactions     Transaction[]     @relation("SubscriptionFromTransaction")

  @@index([userId, status, endsAt(sort: Desc)])
  @@index([status, endsAt])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String                @id @default(uuid()) @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  transactionId  String?               @map("transaction_id") @db.Uuid
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  type           SubscriptionEventType
  startsAt       DateTime              @map("starts_at")
  endsAt         DateTime              @map("ends_at")
  note           String?
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor        User?        @relation("SubscriptionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("subscription_events")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @unique @map("order_id")
  userId         String            @map("user_id") @db.Uuid
  planId         String?           @map("plan_id") @db.Uuid
  subscriptionId String?           @map("subscription_id") @db.Uuid
  amountIdr      Int               @map("amount_idr")
  status         TransactionStatus @default(PENDING)
  provider       String            @default("midtrans")
  providerRef    String?           @map("provider_ref")
  snapToken      String?           @map("snap_token")
  redirectUrl    String?           @map("redirect_url")
  invoiceNumber  String?           @unique @map("invoice_number")
  expiresAt      DateTime?         @map("expires_at")
  paidAt         DateTime?         @map("paid_at")
  refundedAt     DateTime?         @map("refunded_at")
  refundReason   String?           @map("refund_reason")
  refundedById   String?           @map("refunded_by") @db.Uuid
  rawPayload     Json?             @map("raw_payload")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription Subscription?     @relation("SubscriptionFromTransaction", fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([status, paidAt])
  @@map("transactions")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  status          String
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  error           String?

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("payment_webhook_events")
}
