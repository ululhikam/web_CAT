// ============================================================================
// exam.prisma — Stage, subtes, sesi, lock, proctoring  (owner: B3)
// ============================================================================

enum SessionStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  ELIMINATED
  EXPIRED
  ABANDONED
  VOIDED
}

enum SubtestStatus {
  LOCKED
  READY
  ACTIVE
  COMPLETED
  EXPIRED
  ELIMINATED
}

enum LockReason {
  TIME_EXPIRED
  ELIMINATED
  VIOLATION
  MANUAL_SUPER_ADMIN
  PREVIOUS_FAILED
}

enum ViolationAction {
  WARN
  LOCK_SUBTEST
  ELIMINATE
  LOCK_ACCOUNT
}

model ExamStage {
  id              String    @id @default(uuid()) @db.Uuid
  code            StageCode @unique
  name            String
  description     String?
  orderIndex      Int       @map("order_index")
  weight          Decimal   @default(0) @db.Decimal(5, 2)
  passingScore    Decimal   @default(60) @map("passing_score") @db.Decimal(5, 2)
  eliminationEnabled Boolean @default(true) @map("elimination_enabled")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subtests     Subtest[]
  sessionStages ExamSessionStage[]

  @@map("exam_stages")
}

model Subtest {
  id               String      @id @default(uuid()) @db.Uuid
  stageId          String      @map("stage_id") @db.Uuid
  code             SubtestCode @unique
  name             String
  orderIndex       Int         @map("order_index")
  questionCount    Int         @map("question_count")
  durationMinutes  Int         @map("duration_minutes")
  weight           Decimal     @default(0) @db.Decimal(5, 2)
  passingScore     Decimal     @default(60) @map("passing_score") @db.Decimal(5, 2)
  eliminationEnabled Boolean   @default(true) @map("elimination_enabled")
  scoringStrategy  String      @default("KEYED_CORRECT") @map("scoring_strategy")
  scoringConfig    Json?       @map("scoring_config")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  stage          ExamStage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  sessionSubtests ExamSessionSubtest[]

  @@unique([stageId, orderIndex])
  @@map("subtests")
}

model ExamSetting {
  id                  String   @id @default("singleton")
  timezone            String   @default("Asia/Jakarta")
  totalPassingScore   Decimal  @default(60) @map("total_passing_score") @db.Decimal(5, 2)
  maxSessionsPerDay   Int      @default(1) @map("max_sessions_per_day")
  gracePeriodShortMs  Int      @default(3000) @map("grace_period_short_ms")
  gracePeriodLongMs   Int      @default(8000) @map("grace_period_long_ms")
  /// on_open | immediate — kapan timer subtes berikutnya mulai berjalan.
  subtestTransition   String   @default("on_open") @map("subtest_transition")
  violationPolicy     Json     @map("violation_policy")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("exam_settings")
}

model ExamSession {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  status        SessionStatus @default(CREATED)
  examDate      DateTime      @map("exam_date") @db.Date
  totalScore    Decimal?      @map("total_score") @db.Decimal(8, 4)
  passed        Boolean?
  scoringVersion Int          @default(1) @map("scoring_version")
  /// Subtes yang menyebabkan gugur (null bila tidak gugur).
  eliminatedSubtestCode SubtestCode? @map("eliminated_subtest_code")
  eliminationReason String?    @map("elimination_reason")
  configSnapshot Json         @map("config_snapshot")
  startedAt     DateTime?     @map("started_at")
  finishedAt    DateTime?     @map("finished_at")
  voidedAt      DateTime?     @map("voided_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages       ExamSessionStage[]
  subtests     ExamSessionSubtest[]
  violations   ExamViolation[]
  proctoring   ProctoringEvent[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, examDate])
  @@index([status])
  @@index([examDate])
  @@map("exam_sessions")
}

model ExamSessionStage {
  id          String        @id @default(uuid()) @db.Uuid
  sessionId   String        @map("session_id") @db.Uuid
  stageId     String        @map("stage_id") @db.Uuid
  stageCode   StageCode     @map("stage_code")
  stageOrder  Int           @map("stage_order")
  status      SessionStatus @default(CREATED)
  percentage  Decimal?      @db.Decimal(8, 4)
  passed      Boolean?
  availableFrom DateTime?   @map("available_from")
  startedAt   DateTime?     @map("started_at")
  finishedAt  DateTime?     @map("finished_at")

  session  ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stage    ExamStage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  subtests ExamSessionSubtest[]

  @@unique([sessionId, stageOrder])
  @@unique([sessionId, stageId])
  @@map("exam_session_stages")
}

model ExamSessionSubtest {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  sessionStageId String      @map("session_stage_id") @db.Uuid
  subtestId    String        @map("subtest_id") @db.Uuid
  subtestCode  SubtestCode   @map("subtest_code")
  orderIndex   Int           @map("order_index")
  status       SubtestStatus @default(LOCKED)
  rawScore     Decimal?      @map("raw_score") @db.Decimal(10, 4)
  maxScore     Decimal?      @map("max_score") @db.Decimal(10, 4)
  percentage   Decimal?      @db.Decimal(8, 4)
  passed       Boolean?
  answeredCount Int          @default(0) @map("answered_count")
  correctCount  Int          @default(0) @map("correct_count")
  wrongCount    Int          @default(0) @map("wrong_count")
  blankCount    Int          @default(0) @map("blank_count")
  consistencyIndex Decimal?  @map("consistency_index") @db.Decimal(8, 4)
  /// Snapshot konfigurasi subtes saat dibuka (durasi, bobot, ambang, strategi).
  configSnapshot Json?       @map("config_snapshot")
  startedAt    DateTime?     @map("started_at")
  endsAt       DateTime?     @map("ends_at")
  finishedAt   DateTime?     @map("finished_at")
  scoredAt     DateTime?     @map("scored_at")
  resultProfile Json?        @map("result_profile")

  session      ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionStage ExamSessionStage  @relation(fields: [sessionStageId], references: [id], onDelete: Cascade)
  subtest      Subtest           @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  lock         SubtestLock?
  questions    ExamSessionQuestion[]

  @@index([sessionId, orderIndex])
  @@unique([sessionId, subtestId])
  @@index([status, endsAt])
  @@map("exam_session_subtests")
}

model SubtestLock {
  id               String     @id @default(uuid()) @db.Uuid
  subtestSessionId String     @unique @map("subtest_session_id") @db.Uuid
  reason           LockReason
  note             String?
  unlockedAt       DateTime?  @map("unlocked_at")
  unlockedBy       String?    @map("unlocked_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")

  subtestSession ExamSessionSubtest @relation(fields: [subtestSessionId], references: [id], onDelete: Cascade)

  @@map("subtest_locks")
}

model ExamSessionQuestion {
  id               String  @id @default(uuid()) @db.Uuid
  subtestSessionId String  @map("subtest_session_id") @db.Uuid
  /// Relasi opsional: sampai gate G2 pool soal dibaca dari port (mock/fixture),
  /// sehingga baris bank soal belum tentu ada di database.
  questionId       String? @map("question_id") @db.Uuid
  /// Kode publik soal dari pool — kunci idempotensi materialisasi.
  externalId       String  @map("external_id")
  position         Int
  columnIndex      Int?    @map("column_index")
  optionOrder      Json    @map("option_order")
  /// Snapshot konten + kunci saat subtes dibuka (server-only; tidak pernah
  /// dikirim ke klien). Penilaian selalu memakai snapshot ini.
  snapshot         Json    @map("snapshot")
  /// Jawaban terakhir (hasil UPSERT autosave). Null = belum dijawab.
  answerPayload    Json?   @map("answer_payload")
  answeredAt       DateTime? @map("answered_at")
  revision         Int     @default(0)
  timeSpentMs      Int     @default(0) @map("time_spent_ms")

  subtestSession ExamSessionSubtest @relation(fields: [subtestSessionId], references: [id], onDelete: Cascade)
  question       Question?          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers        ExamAnswerEvent[]

  @@unique([subtestSessionId, externalId])
  @@unique([subtestSessionId, position])
  @@index([subtestSessionId, columnIndex, position])
  @@map("exam_session_questions")
}

model ExamAnswerEvent {
  id               String   @id @default(uuid()) @db.Uuid
  sessionQuestionId String  @map("session_question_id") @db.Uuid
  clientSeq        Int      @map("client_seq")
  answerPayload    Json     @map("answer_payload")
  isCorrect        Boolean? @map("is_correct")
  scoreAwarded     Decimal? @map("score_awarded") @db.Decimal(10, 4)
  answeredAt       DateTime @default(now()) @map("answered_at")

  sessionQuestion ExamSessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)

  @@unique([sessionQuestionId, clientSeq])
  @@index([sessionQuestionId, answeredAt(sort: Desc)])
  @@map("exam_answer_events")
}

model ProctoringEvent {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  clientEventId   String   @map("client_event_id")
  type            String
  severity        String
  occurredAtClient DateTime? @map("occurred_at_client")
  occurredAtServer DateTime @default(now()) @map("occurred_at_server")
  metadata        Json?

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientEventId])
  @@index([sessionId, type])
  @@map("proctoring_events")
}

model ExamViolation {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  type           String
  count          Int             @default(0)
  actionTaken    ViolationAction? @map("action_taken")
  policySnapshot Json?           @map("policy_snapshot")
  lastAt         DateTime        @default(now()) @map("last_at")

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, type])
  @@map("exam_violations")
}
