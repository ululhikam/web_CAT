{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @webcat/api prisma:generate && pnpm turbo run build --filter=@webcat/api",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "regions": ["sin1"]
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/api/v1/internal/cron/expire-subscriptions", "schedule": "0 1 * * *" },
    { "path": "/api/v1/internal/cron/cleanup", "schedule": "0 18 * * *" }
  ]
}
