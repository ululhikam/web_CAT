{
  "name": "@webcat/mocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixture deterministik 1090 soal + MSW handler untuk dev tanpa database",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./handlers": "./src/handlers.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "tsx scripts/generate-fixtures.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@webcat/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "msw": "^2.6.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
