{
  "name": "@webcat/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Kontrak bersama: envelope, error codes, pagination, RBAC, Zod schema per domain, port interfaces",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./users": {
      "types": "./dist/users/index.d.ts",
      "default": "./dist/users/index.js"
    },
    "./plans": {
      "types": "./dist/plans/index.d.ts",
      "default": "./dist/plans/index.js"
    },
    "./exams": {
      "types": "./dist/exams/index.d.ts",
      "default": "./dist/exams/index.js"
    },
    "./categories": {
      "types": "./dist/categories/index.d.ts",
      "default": "./dist/categories/index.js"
    },
    "./questions": {
      "types": "./dist/questions/index.d.ts",
      "default": "./dist/questions/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./imports": {
      "types": "./dist/imports/index.d.ts",
      "default": "./dist/imports/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
