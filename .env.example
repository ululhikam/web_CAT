# ============================================================
# Web CAT — contoh environment. Salin ke .env lalu isi nilainya.
# JANGAN pernah commit .env asli. Hanya service role key yang
# boleh ada di server; client hanya memakai anon key.
# ============================================================

# ---------- Runtime ----------
NODE_ENV=development
TZ=Asia/Jakarta
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ---------- Supabase / Postgres ----------
# Pooler (transaction mode, port 6543) untuk runtime serverless
DATABASE_URL=postgresql://postgres.project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Koneksi langsung (port 5432) hanya untuk migrasi
DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
SUPABASE_URL=https://project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ---------- Mail ----------
# console | resend
MAIL=console
RESEND_API_KEY=
MAIL_FROM="Web CAT <no-reply@example.com>"

# ---------- Storage ----------
# dev | supabase
STORAGE=dev

# ---------- Ports / adapters ----------
# dev | billing
ACCESS_POLICY=dev
# dev | db
QUESTION_POOL=dev
# fake | midtrans
PAYMENT=fake
# heuristic | ai
DOC_EXTRACTOR=heuristic
IMPORT_AI_ENABLED=false

# ---------- Midtrans ----------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---------- Ops ----------
CRON_SECRET=change-me-cron-secret
SENTRY_DSN=
LOG_LEVEL=info
