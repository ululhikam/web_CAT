# =============================================================================
# Web CAT — contoh environment.
#
# Cara pakai:
#   1. Salin file ini menjadi `.env` di root repo (bukan di apps/).
#   2. Isi nilai yang bertanda <...> dari dashboard Supabase.
#   3. Jalankan `pnpm env:check` untuk memastikan semuanya valid.
#
# ATURAN KEAMANAN
#   - `.env` TIDAK boleh di-commit (sudah masuk .gitignore).
#   - `SUPABASE_SERVICE_ROLE_KEY` hanya untuk server. Jangan pernah
#     memakainya di kode browser / variabel berawalan PUBLIC_.
#   - Nilai secret di bawah ini contoh; ganti dengan hasil generate sendiri:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=development
TZ=Asia/Jakarta
# Dipakai untuk CORS di API: origin web yang diizinkan (pisahkan dengan koma).
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000

# =============================================================================
# SUPABASE
# Dashboard -> Project Settings -> Database
# -----------------------------------------------------------------------------
# Supabase menyediakan beberapa bentuk connection string:
#
#   a) Transaction pooler  (port 6543) -> DATABASE_URL
#      Dipakai runtime serverless: koneksi dipinjam per transaksi sehingga
#      aman untuk banyak function paralel.
#
#   b) Session pooler      (port 5432) -> DIRECT_URL
#      Dipakai Prisma Migrate/seed/introspeksi: butuh koneksi yang stabil.
#      Gunakan host `db.<ref>.supabase.co` bila project Anda masih
#      mengaktifkan koneksi langsung (IPv4 add-on / jaringan IPv6).
#      Bila tidak, pakai pooler mode session yang juga di port 5432.
#
# Keduanya memakai password database yang sama (Project Settings -> Database
# -> Database password). Karakter khusus pada password WAJIB di-URL-encode
# (mis. `@` -> %40, `#` -> %23, `!` -> %21).
# =============================================================================

# a) Transaction pooler (6543) — untuk aplikasi
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# b) Session pooler / direct (5432) — untuk migrasi & seed
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Project Settings -> API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Kunci publik (aman dipakai di browser, tetap jangan ditanam di repo).
SUPABASE_ANON_KEY=
# Kunci rahasia — HANYA untuk server (Storage admin, bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Storage: `dev` = penyimpanan palsu di memori, `supabase` = bucket asli.
STORAGE=dev
# Nama bucket untuk aset soal & berkas impor (buat manual di dashboard).
SUPABASE_STORAGE_BUCKET=webcat-assets

# ---------- Auth ----------
# Wajib >= 32 karakter. Nilai di bawah hanya contoh.
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-with-a-different-value-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Kosongkan di produksi agar cookie memakai domain host saat ini.
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ---------- Mail ----------
# console = cetak ke log (dev), resend = kirim email sungguhan
MAIL=console
RESEND_API_KEY=
MAIL_FROM="Web CAT <no-reply@example.com>"

# ---------- Port / adapter ----------
# dev | billing
ACCESS_POLICY=dev
# Batas default request per menit (per pengguna login, atau per IP anonim).
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# dev | db  (db = bank soal nyata; dev = fixture sintetis + log peringatan)
QUESTION_POOL=db
# fake | midtrans
PAYMENT=fake
# heuristic | ai
DOC_EXTRACTOR=heuristic
IMPORT_AI_ENABLED=false

# ---------- Midtrans ----------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
FAKE_PAYMENT_SECRET=

# ---------- Ops ----------
# Dipakai Vercel Cron untuk memanggil endpoint /internal/cron/*.
CRON_SECRET=change-me-cron-secret
# Peringatan backlog dicatat bila job PENDING melewati ambang ini.
JOB_BACKLOG_ALERT_THRESHOLD=100
SENTRY_DSN=
LOG_LEVEL=info

# ---------- Bootstrap SUPER_ADMIN & ADMIN (sekali pakai saat seed) ----------
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-min-10-chars
BOOTSTRAP_SUPER_ADMIN_NAME="Super Admin"

# Akun ADMIN operasional (tanpa audit log & pengaturan platform).
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-10-chars
BOOTSTRAP_ADMIN_NAME="Admin Operasional"

# Isi "true" untuk menambahkan peserta contoh saat seed (khusus dev).
SEED_DEMO_USERS=false

# ---------- Skrip operasional ----------
# `pnpm db:guard` menolak menjalankan migrasi destruktif ke database remote
# kecuali diizinkan eksplisit di sini.
ALLOW_REMOTE_DB=false
# Konfirmasi tambahan untuk `migrate reset` (isi: nama database).
CONFIRM_DATABASE=
# Database terpisah untuk mengecek drift migrasi (CI). Boleh sama saat lokal.
SHADOW_DATABASE_URL=

# ---------- Test integrasi ----------
# Database TERPISAH untuk pnpm test:integration. Helper test melakukan
# TRUNCATE, jadi JANGAN arahkan ke database aplikasi.
# Buat DB kosong lalu jalankan: pnpm --filter @webcat/api prisma:deploy
DATABASE_URL_TEST=